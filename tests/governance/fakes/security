#!/usr/bin/env python3
"""替身 macOS `security`（spec §2.2、§4.4）：把參數以一行 JSON 記到 $FAKE_SECURITY_LOG；
$FAKE_SECURITY_FAIL 有值時 exit 44（模擬 Keychain 找不到項目），否則把 $FAKE_SECURITY_PEM 檔的內容印到 stdout。"""
import json
import os
import sys

log = os.environ.get("FAKE_SECURITY_LOG")
if log:
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps(sys.argv[1:]) + "\n")
if os.environ.get("FAKE_SECURITY_FAIL"):
    print("security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain.", file=sys.stderr)
    sys.exit(44)
with open(os.environ["FAKE_SECURITY_PEM"], encoding="utf-8") as f:
    sys.stdout.write(f.read())
