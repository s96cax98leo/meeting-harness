#!/usr/bin/env bash
# ms_bin/ffmpeg —— 放在 PATH 最前面攔截 bin/diarize.sh 的裸 ffmpeg 呼叫（meeting-speed spec §4.8.8）：
# 每次呼叫在 MS_FFMPEG_LOG 附加一行（參數以 \x1f 分隔），再交給真的 ffmpeg（MS_REAL_FFMPEG）。
set -uo pipefail
[[ -n "${MS_FFMPEG_LOG:-}" ]] && printf '%s\n' "$(printf '%s\x1f' "$@")" >> "${MS_FFMPEG_LOG}"
exec "${MS_REAL_FFMPEG:?ms_bin/ffmpeg 需要 MS_REAL_FFMPEG}" "$@"
