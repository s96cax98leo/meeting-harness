{
  "$id": "envelope",
  "title": "agent 交件信封（所有 agent 共用）",
  "description": "agent 交件區塊的 JSON 版。成果一律寫成檔案，信封只放路徑。語意規則（有 blocking 問題就不能 done 等）在 tools/check_envelope.py。",
  "type": "object",
  "required": ["status", "summary", "artifacts", "evidence", "confidence", "open_questions", "derived_work", "payload"],
  "properties": {
    "status": {"type": "string", "enum": ["done", "blocked", "needs_decision"], "description": "done 只能在驗收條件全達成、沒有 blocking 問題時使用"},
    "summary": {"type": "string", "minLength": 1, "description": "一到三句：做了什麼、結果如何"},
    "artifacts": {"type": "array", "items": {"type": "string"}, "description": "產出或改動的檔案路徑（絕對路徑或相對工作區）"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source", "result"],
        "properties": {
          "claim": {"type": "string", "description": "要佐證的說法"},
          "source": {"type": "string", "description": "路徑:行號，或可重跑的指令"},
          "result": {"type": "string", "description": "看到的結果（輸出摘要）"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "blocking", "options", "recommendation", "default_applied"],
        "properties": {
          "question": {"type": "string"},
          "blocking": {"type": "boolean", "description": "不決定就做不下去"},
          "why_blocking": {"type": "string"},
          "options": {"type": "array", "items": {"type": "object", "required": ["choice", "cost"], "properties": {"choice": {"type": "string"}, "cost": {"type": "string"}}}},
          "recommendation": {"type": "string"},
          "default_applied": {"type": "string", "description": "已先套用的預設；沒有寫 none"}
        }
      }
    },
    "derived_work": {"type": "array", "items": {"type": "string"}, "description": "衍生工作，不編號（任務編號由 使用者 發）"},
    "payload": {"type": "object", "description": "依角色而定，見 payloads/*.schema.json；build.py 組合時會替換這裡"}
  }
}
